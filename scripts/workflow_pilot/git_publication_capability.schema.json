{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laqieer/fireemblem8-expansion/schemas/workflow-pilot-git-publication-capability-v1.json",
  "title": "Workflow-pilot protected Git publication launch capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "installation_id",
    "repository",
    "issue",
    "plan_identity",
    "operation",
    "capability_nonce",
    "issued_at",
    "expires_at",
    "signer",
    "actor",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "workflow-pilot-authenticated-git-broker-v1"},
    "installation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "issue": {"type": "integer", "minimum": 1},
    "plan_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"enum": ["preflight", "publish"]},
    "capability_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "x-workflow-pilot-format": "rfc3339-utc-second",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "x-workflow-pilot-format": "rfc3339-utc-second",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signer": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
