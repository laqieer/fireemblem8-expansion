{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review-family request (data, not tool authorization)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "pull_request", "base_sha", "candidate_sha", "subjects", "findings"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])"},
    "pull_request": {"type": "integer", "minimum": 1},
    "base_sha": {"$ref": "#/$defs/sha"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "subjects": {
      "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "subject"],
        "properties": {"case_id": {"$ref": "#/$defs/case"}, "subject": {"$ref": "#/$defs/name"}}
      }
    },
    "findings": {
      "type": "array", "maxItems": 50, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["finding_id", "case_id", "subject", "family", "reported_member"],
        "properties": {
          "finding_id": {"$ref": "#/$defs/name"},
          "case_id": {"$ref": "#/$defs/case"},
          "subject": {"$ref": "#/$defs/name"},
          "family": {"enum": ["action", "lifecycle", "wire", "generated", "resource"]},
          "reported_member": {"$ref": "#/$defs/name"}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$(?![\\s\\S])"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$(?![\\s\\S])"},
    "case": {"type": "string", "pattern": "^TC-[A-Z0-9]+(?:-[A-Z0-9]+)+$(?![\\s\\S])"}
  }
}
