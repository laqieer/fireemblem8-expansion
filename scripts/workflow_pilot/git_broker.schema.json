{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laqieer/fireemblem8-expansion/blob/master/scripts/workflow_pilot/git_broker.schema.json",
  "title": "Exact issue-scoped signed Git publication plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "deployment_id", "repository", "repository_id",
    "issue", "endpoint", "actor_id", "signer_key_id", "client_certificate_sha256",
    "operation", "sequence", "nonce", "issued_at", "expires_at", "updates", "pack", "signature"
  ],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "protocol": {"const": "workflow-pilot-authenticated-git-broker-v1"},
    "deployment_id": {"$ref": "#/$defs/digest"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/(?!\\.{1,2}(?![\\s\\S]))[A-Za-z0-9_.-]{1,100}(?![\\s\\S])"},
    "repository_id": {"$ref": "#/$defs/positive"},
    "issue": {"$ref": "#/$defs/positive"},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 4096},
    "actor_id": {"$ref": "#/$defs/positive"},
    "signer_key_id": {"$ref": "#/$defs/digest"},
    "client_certificate_sha256": {"$ref": "#/$defs/digest"},
    "operation": {"enum": ["bootstrap", "advance", "bind"]},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "nonce": {"$ref": "#/$defs/digest"},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "updates": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["ref", "old", "new"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^refs/heads/workflow-pilot/(?:authority|authority-anchor)/issue-[1-9][0-9]*(?![\\s\\S])"
          },
          "old": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/oid"}]},
          "new": {"$ref": "#/$defs/oid"}
        }
      }
    },
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "size", "objects"],
      "properties": {
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 32, "maximum": 16777216},
        "objects": {
          "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
          "items": {"$ref": "#/$defs/oid"}
        }
      }
    },
    "signature": {"type": "string", "minLength": 344, "maxLength": 684}
  },
  "$defs": {
    "positive": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "oid": {"type": "string", "pattern": "^(?!0{40}(?![\\s\\S]))[0-9a-f]{40}(?![\\s\\S])"},
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)|(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z(?![\\s\\S])"
    }
  }
}
