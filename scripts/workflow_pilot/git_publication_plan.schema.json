{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laqieer/fireemblem8-expansion/schemas/workflow-pilot-git-publication-plan-v1.json",
  "title": "Workflow-pilot authenticated Git publication plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "installation_id",
    "repository",
    "issue",
    "endpoint",
    "operation",
    "authority_ref",
    "anchor_ref",
    "expected_authority_oid",
    "expected_anchor_oid",
    "new_authority_oid",
    "new_anchor_oid",
    "object_ids",
    "pack_sha256",
    "pack_size",
    "nonce",
    "sequence",
    "issued_at",
    "expires_at",
    "signer",
    "actor",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol": {"const": "workflow-pilot-authenticated-git-broker-v1"},
    "installation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "issue": {"type": "integer", "minimum": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "operation": {"const": "publish-authority-anchor"},
    "authority_ref": {"type": "string", "pattern": "^refs/heads/workflow-pilot/issue-[1-9][0-9]*/authority$"},
    "anchor_ref": {"type": "string", "pattern": "^refs/tags/workflow-pilot/issue-[1-9][0-9]*/anchor$"},
    "expected_authority_oid": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "expected_anchor_oid": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "new_authority_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "new_anchor_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "object_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    },
    "pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pack_size": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "x-workflow-pilot-format": "rfc3339-utc-second",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "x-workflow-pilot-format": "rfc3339-utc-second",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "signer": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
        "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    }
  }
}
